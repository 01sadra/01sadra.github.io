    <item>
      <title>یازده نکته درباره انتخابات آمریکا</title>
      <link>//localhost:1313/blog/2016/11/2016-11-17-%DB%8C%D8%A7%D8%B2%D8%AF%D9%87-%D9%86%DA%A9%D8%AA%D9%87-%D8%AF%D8%B1%D8%A8%D8%A7%D8%B1%D9%87-%D8%A7%D9%86%D8%AA%D8%AE%D8%A7%D8%A8%D8%A7%D8%AA-%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7/</link>
      <pubDate>Thu, 17 Nov 2016 00:00:00 +0000</pubDate>
      <guid>//localhost:1313/blog/2016/11/2016-11-17-%DB%8C%D8%A7%D8%B2%D8%AF%D9%87-%D9%86%DA%A9%D8%AA%D9%87-%D8%AF%D8%B1%D8%A8%D8%A7%D8%B1%D9%87-%D8%A7%D9%86%D8%AA%D8%AE%D8%A7%D8%A8%D8%A7%D8%AA-%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7/</guid>
      <description>&lt;p&gt;برخلاف &lt;a href=&#34;http://twelve.me/%d9%87%db%8c%d8%a7%d9%87%d9%88-%d8%a8%d8%b1%d8%a7%db%8c-%d9%86%d8%a7%d8%b1%da%af%db%8c%d9%84%db%8c-%da%a9%d9%87-%d8%af%d8%b3%d8%aa-%d9%85%d8%a7-%d8%a8%d9%87%d8%b4-%d9%86%d9%85%db%8c%d8%b1%d8%b3%d9%87/&#34;&gt;مهدی&lt;/a&gt; که احتمالا اصلا از خواندن این متن خوشحال نخواهد شد، فکر میکنم ما نیاز داریم که درباره انتخابات آمریکا صحبت کنیم. نه به این علت که مامیتوانیم کمترین تاثیری بر نتیجه‌ی آن بگذاریم بلکه به علت تمرین ذهن برای تحلیل و درس گرفتن از آن برای جامعه‌ی خودمان که به نظرم خیلی به جامعه آمریکا شبیه است. قبلا هم گفته ام انسان ایرانی به انسان آمریکایی از بسیاری جهات شبیه‌تر است تا به نسبت روس یا انسان عربستانی یا انسان چینی و الخ.&lt;/p&gt;</description>
